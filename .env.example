# Copy to .env for local runs (node --env-file=.env server/index.js). On Render, set these in the dashboard.
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data

# Claude API key for the AI engine (https://platform.claude.com > API keys)
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_BEST=claude-sonnet-5-5

# First admin account, created on first start if it does not exist (password: 8+ chars, a letter and a number)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Shown on the login page for password help
SUPPORT_EMAIL=

# Social channels. Each network switches on when both of its values are set. See CHANNELS.md.
# Redirect URL to register with each network: <PUBLIC_URL>/auth/callback/<linkedin|x|meta|threads>
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
# Optional: key used to encrypt social tokens. If empty, a random key is created in DATA_DIR/token.key.
TOKEN_ENCRYPTION_KEY=

# Easiest: one Zernio API key (zernio.com) connects all 8 networks with no developer apps. Overrides the per-network keys above.
ZERNIO_API_KEY=
